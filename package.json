{
  "name": "rhubarb",
  "version": "0.1.0",
  "private": true,
  "description": "Most of your day is rhubarb. Some of it is worth learning. A tutor that listens through the Bee wearable.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:daemon": "npm run dev -w @rhubarb/daemon",
    "dev:dashboard": "npm run dev -w @rhubarb/dashboard"
  }
}
